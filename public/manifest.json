{
    "manifest_version": 3,
    "name": "E-Tsena",
    "description": "Web Extension pour commander sur AliExpress depuis Madagascar",
    "key": "",
    "version": "1.0",
    "action": {
        "default_popup": "index.html",
        "default_icon": {
            "16": "icons/16x16.png",
            "48": "icons/48x48.png",
            "128": "icons/128x128.png"
        }
    },
    "permissions": [
        "identity",
        "notifications",
        "storage",
        "alarms"
    ],
    "host_permissions": [
        "https://fr.aliexpress.com/*",
        "https://e-tsena-dropshipping.onrender.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "oauth2": {
        "client_id": "535026693538-tnepqqo7s68h90snlaovmupeiupar9k5.apps.googleusercontent.com",
        "scopes":["openid", "profile", "email"]
    },
    "icons": {
        "16": "icons/16x16.png",
        "48": "icons/48x48.png",
        "128": "icons/128x128.png"
    }
}
