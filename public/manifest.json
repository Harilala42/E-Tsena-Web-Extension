{
    "manifest_version": 3,
    "name": "E-Tsena",
    "description": "Web Extension pour commander sur Aliexpress depuis Madagascar",
    "version": "1.0",
    "action": {
        "default_popup": "index.html",
        "default_icon": {
            "16": "icons/16x16.png",
            "48": "icons/48x48.png",
            "128": "icons/128x128.png"
        }
    },
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "https://fr.aliexpress.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["https://fr.aliexpress.com/*"],
            "js": ["content.js"]
        }
    ],
    "icons": {
        "16": "icons/16x16.png",
        "48": "icons/48x48.png",
        "128": "icons/128x128.png"
    }
}
  
  